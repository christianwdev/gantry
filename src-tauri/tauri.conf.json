{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gantry",
  "identifier": "dev.gantry.app",
  "build": {
    "beforeDevCommand": "bun run --filter @gantry/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --filter @gantry/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gantry",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
