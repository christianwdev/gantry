{
  "name": "gantry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --filter @gantry/desktop typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
